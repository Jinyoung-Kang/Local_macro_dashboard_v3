# AWS 데모 배포용 .env — 이름만 적습니다(값은 서버의 .env에만). compose.aws.yml · ADR 0012 참고.
# 로컬 .env.example의 값 중 쓰는 것 + 아래 배포 전용 값.
# ⚠️ COOKIE_SECURE는 .env.example에서 옮겨 오지 마세요. 거기 값은 로컬 http용 false이고, 서버 .env에 들어가면
#    compose.aws.yml의 기본값 true(세션 쿠키에 Secure)를 덮어씁니다. 이 이름은 서버 .env에 적지 않습니다.
#    (LOCAL_NO_LOGIN·DASHBOARD_READ_MODE·MAIL_HOST는 compose.aws.yml이 값을 박아 두어 .env에 있어도 쓰이지 않습니다.
#     웹 데모는 로컬의 '로그인 없이 운영자로 열기'가 늘 꺼져 있어 로그인 화면을 그대로 거칩니다 — ADR 0016)

# ── 배포 전용 ──
RDS_HOST=
RDS_PORT=
PUBLIC_ORIGIN=

# ── DB 계정 (RDS 초기화 스크립트가 같은 이름·비밀번호로 만듦) ──
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ── 운영자 계정 · 내부 토큰 ──
OWNER_EMAIL=
APP_PASSWORD=
COLLECTOR_API_TOKEN=
# 데모 열람(ADR 0013) — 앞단 Caddy가 공개 쪽 요청에 X-Demo-Viewer로 싣는 값과 같게. 32자 이상(openssl rand -hex 32), 비우면 꺼짐
DEMO_VIEWER_TOKEN=

# ── AI 리포트 (ADR 0014) — 엔진은 Claude Haiku 5.5 하나(compose.aws.yml이 AI_ENGINES로 고정) ──
# 운영자의 Anthropic 계정 키. 비우면 AI 메뉴가 꺼집니다
ANTHROPIC_API_KEY=
# 데모 방문자 전체가 함께 쓰는 하루(KST) AI 리포트 건수(비우면 20). 메모리에서 세므로 재시작하면 0부터
AI_DEMO_DAILY_LIMIT=

# ── 백엔드 ──
# 비싼 계산 동시 실행 상한(QA-131). 비우면 자동 = 코어 수의 절반, 최소 1(vCPU 2개면 1 — 나머지는 이웃 프로젝트·health 몫)
COMPUTE_MAX_CONCURRENT=

# ── 수집 ──
COLLECTOR_SCHEDULER=
SEC_USER_AGENT=
FRED_API_KEY=
KRX_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
LS_APP_KEY=
LS_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
DATA_GO_KR_SERVICE_KEY=
DART_API_KEY=
