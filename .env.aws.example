# AWS 데모 배포용 .env — 이름만 적습니다(값은 서버의 .env에만). compose.aws.yml · ADR 0012 참고.
# 로컬 .env.example의 값 중 쓰는 것 + 아래 배포 전용 값.

# ── 배포 전용 ──
RDS_HOST=
RDS_PORT=
PUBLIC_ORIGIN=

# ── DB 계정 (RDS 초기화 스크립트가 같은 이름·비밀번호로 만듦) ──
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ── 운영자 계정 · 내부 토큰 ──
OWNER_EMAIL=
APP_PASSWORD=
COLLECTOR_API_TOKEN=
# 데모 열람(ADR 0013) — 앞단 Caddy가 공개 쪽 요청에 X-Demo-Viewer로 싣는 값과 같게. 32자 이상(openssl rand -hex 32), 비우면 꺼짐
DEMO_VIEWER_TOKEN=

# ── 수집 ──
COLLECTOR_SCHEDULER=
SEC_USER_AGENT=
FRED_API_KEY=
KRX_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
LS_APP_KEY=
LS_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
DATA_GO_KR_SERVICE_KEY=
DART_API_KEY=
